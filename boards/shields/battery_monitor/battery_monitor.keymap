/*
 * battery_monitor.keymap
 * Keymap for Battery Monitor Shield
 * 
 * Location: config/boards/shields/battery_monitor/battery_monitor.keymap
 * 
 * Single button functionality:
 * - Hold 2 seconds: Clear all Bluetooth bonds
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        bond_clear_hold: bond_clear_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <2000>;
            bindings = <&bt>, <&trans>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = 
                <&bond_clear_hold BT_CLR 0>
            ;
        };
    };
};

/*
 * Button behavior:
 * - Press briefly (< 2 seconds): Does nothing (transparent/no action)
 * - Hold for 2+ seconds: Clear all Bluetooth bonds and reset connections
 * 
 * This prevents accidental bond clearing while allowing intentional reset
 */