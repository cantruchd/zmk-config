/*
 * battery_monitor.keymap
 * Keymap for Battery Monitor Shield
 * 
 * Location: config/boards/shields/battery_monitor/battery_monitor.keymap
 * 
 * Single button functionality:
 * - Hold 2 seconds: Clear all Bluetooth bonds
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        /*
         * Custom hold-tap behavior for bond clearing
         * Requires 2 second hold to clear bonds
         */
        bond_clear: bond_clear {
            compatible = "zmk,behavior-hold-tap";
            label = "BOND_CLEAR";
            #binding-cells = <2>;
            tapping-term-ms = <2000>;
            flavor = "hold-preferred";
            bindings = <&bt>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &bond_clear BT_CLR 0
            >;
        };
    };
};

/*
 * Button behavior:
 * - Press and hold for 2 seconds: Clear all Bluetooth bonds and reset connections
 * - Short press (< 2 seconds): Does nothing (sends key code 0)
 * 
 * This prevents accidental bond clearing while allowing intentional reset
 */