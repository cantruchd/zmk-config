/*
 * battery_monitor.overlay
 * Hardware configuration for Battery Monitor Shield (2 nice!nano setup)
 * 
 * Location: config/boards/shields/battery_monitor/battery_monitor.overlay
 * 
 * Each nice!nano monitors one cell via BAT+ pin (built-in voltage sensing)
 * Board #1: Cell 1 (BAT+ = Cell 1+, GND = Cell 1-)
 * Board #2: Cell 2 (BAT+ = Cell 2+, GND = Cell 1+)
 */

/ {
    chosen {
        zmk,battery = &vbatt;
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
    };

    /*
     * Dummy kscan (required by ZMK even with no physical keys)
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    /*
     * Dummy matrix transform (required by ZMK)
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <1>;
        rows = <1>;
        map = <0>;
    };

    /*
     * Battery voltage sensing using nice!nano built-in divider
     * Each board automatically monitors its connected cell (3.0-4.2V)
     * No external voltage divider needed!
     */
    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };

    /*
     * MOSFET control for battery power switching
     * GPIO P0.24 (D5 pin on nice!nano) controls MOSFET gate
     */
    mosfet {
        compatible = "gpio-leds";
        mosfet_ctrl: mosfet_control {
            gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
            label = "Battery MOSFET Control";
        };
    };

    /*
     * Reed switch for manual bond clearing (optional)
     * Wave magnet near sensor to clear Bluetooth bonds
     * P0.17 = D2 pin on nice!nano, with internal pull-down
     */
    keys {
        compatible = "gpio-keys";
        reed_switch: reed_switch {
            gpios = <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
            label = "Reed Switch";
        };
    };
};

/*
 * Enable GPIO
 */
&gpio0 {
    status = "okay";
};

/*
 * Enable ADC for battery monitoring
 */
&adc {
    status = "okay";
};

/*
 * Enable temperature sensor (nRF52840 internal)
 */
&temp {
    status = "okay";
};

/*
 * Pin Usage Summary:
 * 
 * BAT+  - Battery positive (Cell 1+ or Cell 2+ depending on board)
 * GND   - Battery negative (Cell 1- for board #1, Cell 1+ for board #2)
 * P0.15 - MOSFET gate control (output, with external 10kΩ pull-down)
 * P0.17 - Reed switch input (optional, input with pull-down)
 * P0.31 - Battery sense power control (built-in, managed by ZMK)
 * 
 * Notes:
 * - Only nice!nano #1 needs MOSFET connected to P0.15
 * - Both boards report battery independently via Bluetooth
 * - Reed switch is optional, can be omitted
 */