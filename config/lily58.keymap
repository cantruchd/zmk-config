#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&sk { release-after-ms = <10000>; };

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

&lt { tapping-term-ms = <300>; };

/ {
    macros {
        shutdown_windows: shutdown_windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(X) &kp U &kp S>;
            label = "SHUTDOWN_WINDOWS";
            wait-ms = <100>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_right {
            bindings = <&kp RIGHT>;
            key-positions = <28 27>;
            layers = <0>;
        };

        combo_left {
            bindings = <&kp LEFT_ARROW>;
            key-positions = <26 27>;
            layers = <0>;
        };

        combo_down {
            bindings = <&kp DOWN>;
            key-positions = <26 27 28>;
            layers = <0>;
        };

        combo_up {
            bindings = <&kp UP_ARROW>;
            key-positions = <28 15>;
            layers = <0>;
        };

        cb_home {
            bindings = <&kp HOME>;
            key-positions = <16 15>;
            layers = <0>;
        };

        cb_end {
            bindings = <&kp END>;
            key-positions = <40 39>;
            layers = <0>;
        };

        cb_left {
            bindings = <&kp LEFT>;
            key-positions = <31 32>;
            layers = <0>;
        };

        cb_right {
            bindings = <&kp RIGHT>;
            key-positions = <33 32>;
            layers = <0>;
        };

        cb_down {
            bindings = <&kp DOWN>;
            key-positions = <32 33 31>;
            layers = <0>;
        };

        cb_up {
            bindings = <&kp UP_ARROW>;
            key-positions = <31 20>;
            layers = <0>;
        };

        cb_home1 {
            bindings = <&kp HOME>;
            key-positions = <19 20>;
            layers = <0>;
        };

        cb_end1 {
            bindings = <&kp END>;
            key-positions = <45 46>;
            layers = <0>;
        };

        winshifts {
            bindings = <&kp LS(RG(S))>;
            key-positions = <25 26>;
            layers = <0>;
            require-prior-idle-ms = <500>;
        };

        cb_delete {
            bindings = <&kp DEL>;
            key-positions = <33 34>;
            layers = <0>;
        };

        indexquote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <35 31>;
            layers = <0>;
        };

        thumbquote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <35 56>;
            layers = <0>;
        };

        f11 {
            bindings = <&kp F11>;
            key-positions = <2 3>;
            layers = <0>;
        };

        f12 {
            bindings = <&kp F12>;
            key-positions = <3 4>;
            layers = <0>;
        };

        alttab {
            bindings = <&kp LA(TAB)>;
            key-positions = <50 12>;
            layers = <0>;
        };

        btclearleft {
            bindings = <&bt BT_CLR>;
            key-positions = <50 51 52>;
            layers = <0>;
        };

        btclearright {
            bindings = <&bt BT_CLR>;
            key-positions = <55 56 57>;
            layers = <0>;
        };

        cb_ctrl_alt_delete {
            bindings = <&kp LA(LC(DELETE))>;
            key-positions = <23 31>;
            layers = <0>;
        };
    };

    behaviors {
        backspace_delete: backspace_delete {
            compatible = "zmk,behavior-tap-dance";
            label = "BACKSPACE_DELETE";
            #binding-cells = <0>;
            bindings = <&kp BACKSPACE>, <&mt DELETE BACKSPACE>;
        };

        mouse_and_layer: mouse_and_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_AND_LAYER";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <(-1)>;
            flavor = "tap-preferred";
        };

        shift_capslock: shift_capslock {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_CAPSLOCK";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kt CAPS>;
        };

        s_wins: s_wins {
            compatible = "zmk,behavior-tap-dance";
            label = "S_WINS";
            #binding-cells = <0>;
            bindings = <&mt LC(S) S>, <&mt LS(LG(S)) LS(LG(S))>;
        };

        tabshifttab: tabshifttab {
            compatible = "zmk,behavior-tap-dance";
            label = "TABSHIFTTAB";
            #binding-cells = <0>;
            bindings = <&mt LA(TAB) TAB>, <&mt LS(LA(TAB)) LS(TAB)>;

            tapping-term-ms = <300>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";

            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&mt GRAVE ESCAPE  &mt F1 NUMBER_1  &mt F2 NUMBER_2  &mt F3 NUMBER_3  &mt F4 NUMBER_4  &mt F5 N5                           &mt F6 NUMBER_6  &mt F7 N7         &mt F8 NUMBER_8         &mt F9 N9                 &mt F10 NUMBER_0     &mt EQUAL MINUS
&tabshifttab      &kp Q            &kp W            &kp E            &kp R            &kp T                               &kp Y            &mt HOME U        &mt UP_ARROW I          &kp O                     &mt LG(P) P          &kp BACKSPACE
&kp LCTRL         &mt LC(A) A      &mt LC(S) S      &mt LG(D) D      &kp F            &kp G                               &kp H            &mt LEFT_ARROW J  &mt DOWN_ARROW K        &mt RIGHT L               &kp SEMI             &mt APOSTROPHE ENTER
&shift_capslock   &mt LC(Z) Z      &mt LC(X) X      &mt LC(C) C      &mt LC(V) V      &mt LC(B) B  &kp LBKT     &kp RBKT  &kp N            &mt END M         &mt LEFT_BRACKET COMMA  &mt RIGHT_BRACKET PERIOD  &mt BACKSLASH SLASH  &shift_capslock
                                                    &mt LALT HOME    &kp LEFT_WIN     &lt 1 LEFT   &kp SPACE    &kp RET   &lt 2 RIGHT      &lt 6 SPACE       &mt LEFT_CONTROL END
            >;
        };

        lower_layer {
            display-name = "Lower";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp GRAVE  &bt BT_SEL 0  &bt BT_SEL 1     &bt BT_SEL 2       &bt BT_SEL 3     &bt BT_SEL 4                         &trans     &trans    &trans          &trans           &trans            &kp EQUAL
&kp F1     &mkp MCLK     &msc SCRL_LEFT   &mmv MOVE_UP       &msc SCRL_UP     &msc SCRL_RIGHT                      &kp F7     &kp HOME  &kp UP_ARROW    &kp F10          &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&mo 8      &mkp LCLK     &mmv MOVE_LEFT   &mmv MOVE_DOWN     &mmv MOVE_RIGHT  &mkp RCLK                            &kp CARET  &kp LEFT  &kp DOWN        &kp RIGHT        &kp RPAR          &kp SQT
&trans     &soft_off     &msc SCRL_RIGHT  &ext_power EP_TOG  &msc SCRL_DOWN   &shutdown_windows  &trans    &trans  &trans     &kp END   &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp PLUS          &kp BACKSLASH
                                          &kp SPACE          &bootloader      &trans             &trans    &trans  &mo 3      &trans    &trans
            >;
        };

        raise_layer {
            display-name = "Raise";

            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&trans            &trans  &trans  &trans   &trans   &trans                     &bt BT_SEL 4       &bt BT_SEL 3  &bt BT_SEL 2    &bt BT_SEL 1     &bt BT_SEL 0         &kp EQUAL
&kp GRAVE         &kp N1  &kp N2  &kp N3   &kp N4   &kp N5                     &to 4              &kp HOME      &kp UP          &kp N9           &kp LA(PRINTSCREEN)  &kp DELETE
&kp LEFT_CONTROL  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &soft_off          &kp LEFT      &kp DOWN        &kp RIGHT        &kp RIGHT            &sk LEFT_CONTROL
&kp LEFT_SHIFT    &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &shutdown_windows  &kp END       &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp RBKT             &sk RIGHT_SHIFT
                                  &trans   &trans   &mo 3    &trans    &trans  &trans             &bootloader   &bt BT_CLR
            >;
        };

        third {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3       &kp F4      &kp F5                    &kp F6  &kp F7      &kp F8          &kp F9           &kp F10        &kp F11
&trans  &trans  &trans  &trans       &trans      &trans                    &trans  &trans      &trans          &trans           &kp F12        &kp DELETE
&trans  &trans  &trans  &trans       &trans      &trans                    &kp F5  &kp F4      &kp F3          &kp F2           &kp F1         &kp BACKSLASH
&trans  &trans  &trans  &trans       &trans      &trans  &trans    &trans  &trans  &trans      &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp BACKSLASH  &sk RIGHT_SHIFT
                        &bootloader  &sys_reset  &trans  &trans    &trans  &trans  &sys_reset  &bootloader
            >;

            label = "third";
        };

        taipo {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp R   &kp S   &kp N   &kp I   &trans                    &trans  &kp I   &kp N   &kp S   &kp R   &trans
&trans  &kp A   &kp O   &kp T   &kp E   &trans  &trans    &trans  &trans  &kp E   &kp T   &kp O   &kp A   &trans
                        &trans  &trans  &trans  &trans    &trans  &mo 5   &trans  &trans
            >;

            label = "taipo";
        };

        taipo_layer1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &to 0   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;

            label = "taipo layer1";
        };

        reverse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &mt F5 N5  &mt F4 NUMBER_4  &mt N3 NUMBER_3  &mt F2 NUMBER_2  &mt F1 NUMBER_1  &mt LA(LC(DELETE)) ESCAPE
&trans  &trans  &trans  &trans  &trans  &trans                    &kp T      &kp R            &kp E            &kp W            &kp Q            &kp TAB
&trans  &trans  &trans  &trans  &trans  &trans                    &kp G      &kp F            &mt LG(D) D      &mt LS(LG(S)) S  &mt LC(A) A      &sk LCTRL
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp B      &mt LC(V) V      &mt LC(C) C      &kp X            &kp Z            &sk LSHFT
                        &trans  &trans  &trans  &trans    &trans  &sk LALT   &trans           &sk LEFT_GUI
            >;

            label = "reverse";
        };

        control {
            bindings = <
&kp LC(ESCAPE)    &kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &kp LC(NUMBER_4)  &kp LC(N5)                    &kp LC(F5)    &kp LA(F4)    &kp LS(UP_ARROW)  &kp RS(RIGHT)  &kp EQUAL  &kp BACKSLASH
&kp LC(TAB)       &kp LC(Q)         &kp LC(E)         &kp LC(W)         &kp LC(R)         &kp LC(T)                     &kp RC(F5)    &kp RS(LEFT)  &kp RS(DOWN)      &kp LS(RIGHT)  &kt LG(P)  &kp LA(TAB)
&kp LEFT_CONTROL  &kp LC(A)         &kp LC(S)         &kp LC(D)         &kp LC(F)         &kp LC(G)                     &kp LS(HOME)  &kp LC(F)     &kp LG(D)         &kp LG(LS(S))  &kp RC(A)  &kp LC(ENTER)
&kp LEFT_SHIFT    &kp RC(Z)         &kp LC(X)         &kp LC(C)         &kp LC(V)         &kp LC(B)   &trans    &trans  &kp RS(END)   &kp LC(V)     &kp LC(C)         &kp LG(X)      &kp LC(Z)  &sk LG(LEFT_SHIFT)
                                                      &kp LC(LEFT_ALT)  &trans            &trans      &trans    &trans  &trans        &trans        &trans
            >;

            label = "control";
        };

        arrowleft {
            bindings = <
&trans  &trans  &trans    &trans        &trans     &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &kp UP_ARROW  &kp HOME   &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans    &trans        &kp END    &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                          &trans        &trans     &trans  &trans    &trans  &trans  &trans  &trans
            >;

            label = "arrowl left";
        };
    };
};
